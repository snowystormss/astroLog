### 3. fix `MainViewModel.kt`

fixes finding 2: removes the silent `String.hashCode()` coordinate fabrication and triggers `onError()` properly if the city is genuinely unresolved.

in `app/src/main/java/com/example/ui/MainViewModel.kt`, replace the `resolveCityLocation` method with:

```kotlin
    fun resolveCityLocation(
        query: String,
        onResolved: (String, Double, Double) -> Unit,
        onError: () -> Unit
    ) {
        viewModelScope.launch {
            if (query.isBlank()) {
                onError()
                return@launch
            }

            // 1. Fast match from bundled offline database
            val localMatch = CitySearchService.findBestMatch(query)
            if (localMatch != null) {
                onResolved(localMatch.formatted, localMatch.latitude, localMatch.longitude)
                return@launch
            }

            // 2. Try Android system geocoder if query not in offline list
            try {
                val context = getApplication<android.app.Application>()
                val geocoder = android.location.Geocoder(context, java.util.Locale.getDefault())
                val addresses = withContext(kotlinx.coroutines.Dispatchers.IO) {
                    @Suppress("DEPRECATION")
                    geocoder.getFromLocationName(query, 1)
                }
                val match = addresses?.firstOrNull()
                if (match != null && match.hasLatitude() && match.hasLongitude()) {
                    val addressLine = match.getAddressLine(0) ?: query
                    withContext(kotlinx.coroutines.Dispatchers.Main) {
                        onResolved(addressLine, match.latitude, match.longitude)
                    }
                    return@launch
                }
            } catch (_: Exception) {
                // Geocoder service unavailable or offline
            }

            // 3. Do not fabricate coordinates with hashCode(). Report error so user can pick a verified city.
            withContext(kotlinx.coroutines.Dispatchers.Main) {
                onError()
            }
        }
    }

